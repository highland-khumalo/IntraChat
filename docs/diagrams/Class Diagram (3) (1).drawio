        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class DatabaseManager {\n        &lt;&lt;class&gt;&gt;\n        -String DB_URL\n        +initializeDatabase\(\)$\n        +connect\(\)$ Connection\n        +userExists\(String username\)$ boolean\n        +addUser\(String username, String password\)$\n        +addUser\(String username, String password, String isAllowed\)$\n        +authenticateUser\(String username, String password\)$ boolean\n        +authenticateUser\(String username, String password, String requiredIsAllowed\)$ boolean\n        +isUserAllowed\(String username\)$ boolean\n        +updateUserAllowed\(int userId, String isAllowed\)$ boolean\n        +updateUserAllowed\(String username, String isAllowed\)$ boolean\n        +deleteUser\(int userId\)$ boolean\n        +deleteUser\(String username\)$ boolean\n        +updateUserPassword\(int userId, String newPassword\)$ boolean\n        +updateUserPassword\(String username, String newPassword\)$ boolean\n        +logMessage\(String sender, String recipient, String content\)$\n        +displayChatHistory\(\)$\n        +getChatHistoryArrayList\(\)$ ArrayList~Message~\n        +getChatHistoryForRoom\(String room\)$ ArrayList~Message~\n        +getDirectMessageHistory\(String user1, String user2\)$ ArrayList~Message~\n        +getAllUsers\(\)$ List~UserRecord~\n        +getUserCount\(\)$ int\n        +getAcceptedUserCount\(\)$ int\n        +getPendingUserCount\(\)$ int\n    }\n    \n    class Message {\n        +String sender\n        +String recipient\n        +String content\n        +String timestamp\n    }\n\n    class UserRecord {\n        +int id\n        +String username\n        +String isAllowed\n        +String createdAt\n    }\n\n    DatabaseManager --&gt; Message : creates / returns\n    DatabaseManager --&gt; UserRecord : creates / returns&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_oAmzMilA0upcqvJkSxs-1"